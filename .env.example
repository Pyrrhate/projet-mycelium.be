# Copiez ce fichier vers .env.local et renseignez les valeurs du projet Sanity.
# NEXT_PUBLIC_* est requis pour les URLs d’images (navigateur). SANITY_* seul suffit pour le fetch serveur.
# Après création d’un membre dans le Studio : cliquez sur « Publier » (les brouillons n’apparaissent pas sur le site).

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optionnel (serveur uniquement, ex. CI) :
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
